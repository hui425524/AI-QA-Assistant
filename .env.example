# Copy this file to .env. Never commit real credentials.
FLASK_DEBUG=1
AI_MODE=mock
AI_API_KEY=
MAX_REQUIREMENT_CHARS=30000

# Leave blank for the no-persistence mock quickstart.
DATABASE_URL=
# Supabase example (Dashboard > Connect; URL-encode special characters in passwords):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
